    <string name="schedule_once_a_day">once a day</string>
    <string name="schedule_twice_a_day">twice a day</string>
    <!-- %d: how many times a day, always 3 or more -->
    <string name="schedule_n_times_a_day">%d times a day</string>
    <!-- %s: the days, either a list such as "Mon, Wed, Fri" or the word for weekdays -->
    <string name="schedule_once_a_day_on_days">once a day on %s</string>
    <string name="schedule_twice_a_day_on_days">twice a day on %s</string>
    <!-- %1$d: how many times a day, always 3 or more. %2$s: the days -->
    <string name="schedule_n_times_a_day_on_days">%1$d times a day on %2$s</string>
    <!-- Substituted for the day list when the days are exactly Monday to Friday -->
    <string name="schedule_days_weekdays">weekdays</string>
    <string name="schedule_once_every_other_day">once every other day</string>
    <string name="schedule_twice_every_other_day">twice every other day</string>
