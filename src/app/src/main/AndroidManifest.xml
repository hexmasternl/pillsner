<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Reminders, and nothing else. There is deliberately no INTERNET permission: nothing about a
        user's medication ever leaves the device.

        ML Kit's bundled (on-device) text-recognition model was added for the label scan shortcut
        expecting no network permission (medicine-add-label-scan design D1's promise of "no network
        call, ever"), but its telemetry dependencies (Firebase installations/datatransport, pulled
        in transitively by com.google.mlkit:text-recognition regardless of model variant) declare
        INTERNET and ACCESS_NETWORK_STATE in their own manifests, which manifest merging otherwise
        adds silently. Text recognition itself never touches the network, so both are removed here
        to hold the line the comment above already promises.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reserved for apps whose core function is alarms or reminders, which Pillsner's is. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Android 12 only; from 13 the permission above replaces it. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- A reboot clears every alarm, so the app has to set its own again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        The wake runs in a short foreground service, because ten seconds of receiver budget is not
        enough for a cold start that has to open the database (reminder-delivery-reliability D4).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Not a typo: this is the real Android 14 permission, which lint's own list predates. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE"
        tools:ignore="SystemPermissionTypo" />
    <!--
        So a due dose presents itself on a locked or busy phone rather than waiting in the shade
        (design D5). From Android 14 it is granted at install only to alarm and calling apps,
        which Pillsner is; where it is not granted the reminder degrades to a heads-up notification.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!--
        Requested only when the user taps the Medicines screen's "Scan medicine label" button
        (medicine-add-label-scan design D4); denial falls back to the photo picker, which needs no
        permission of its own.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- The scan shortcut is optional chrome; a phone with no camera still installs and runs fully. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
        The vendor power-manager screens the Home banner offers on OEMs that ship one (design D3).
        Visibility is what lets `resolveActivity` answer honestly; without these entries every such
        intent would look absent and the banner would always fall back to the platform setting.
    -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.samsung.android.lool" />
    </queries>

    <application
        android:name=".PillsnerApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pillsner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Pillsner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One per moment the app has to act on. Only AlarmManager sends these, so not exported. -->
        <receiver
            android:name=".data.reminders.ReminderAlarmReceiver"
            android:exported="false"
            android:directBootAware="true" />

        <!--
            Where the wake actually runs (design D4). Direct-boot aware for the same reason the
            receivers are: an alarm may start this process before the first unlock, and the wake's
            own locked guard is what keeps it away from the database until then.

            shortService is available from API 34 and ignored below it, where the same service runs
            as an ordinary foreground service with the same lifetime.
        -->
        <service
            android:name=".data.reminders.ReminderWakeService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="shortService" />

        <!-- The three answers, and the swipe that counts as "Not yet". -->
        <receiver
            android:name=".data.reminders.ReminderActionReceiver"
            android:exported="false" />

        <!--
            Exported because the system sends these broadcasts; each action is protected by the
            platform, so no other app can deliver them.

            Direct-boot aware, so that LOCKED_BOOT_COMPLETED is delivered at all: on a phone with a
            secure lock screen it is the only boot broadcast that arrives before the user unlocks,
            and until then the app has no alarm set (reminder-delivery-after-reboot design D5).
            RECEIVE_BOOT_COMPLETED, declared above, covers the locked variant too.
        -->
        <receiver
            android:name=".data.reminders.SystemEventsReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Gives the system camera intent somewhere to write the temporary label photo
            (medicine-add-label-scan design D5). Scoped to a cache subdirectory only; the file is
            deleted immediately after recognition completes and is never registered with MediaStore.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
