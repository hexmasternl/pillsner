<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-API 31 Auto Backup rules. Mirrors data_extraction_rules.xml so the app lock's DataStore
    file (design D4) is excluded on every supported Android version.
    The OCR trained data under files/ocr/ is excluded for the same reason as in that file: it is
    recreated from the app's assets (medicine-label-photo-prefill design D1).
-->
<full-backup-content>
    <exclude domain="file" path="datastore/applock.preferences_pb" />
    <exclude domain="file" path="ocr/" />
</full-backup-content>
